generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HOST
  CLEANER
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  password     String?
  firstName    String?
  lastName     String?
  phone        String?
  profileImage String?
  role         Role?

  // Shared profile fields (Host + Cleaner both can use)
  about    String?
  playerId String? // OneSignal push notification id

  // Cleaner-only onboarding fields
  siretNumber            String?
  isProfessionalVerified Boolean      @default(false)
  workCity               String?
  workLatitude           Float?
  workLongitude          Float?
  serviceRadius          Int?
  availability           String? // full_time | part_time | flexible
  licenseNumber          String?
  biography              String?
  interventionZone       String?
  languages              String[]     @default([])
  servicesOffered        String[]     @default([])
  assignments            Assignment[]

  // becomes true once the cleaner completes the mandatory
  // post-signup "setup profile" wizard (cannot be skipped)
  isCleanerProfileSetupComplete Boolean @default(false)

  isEmailVerified   Boolean @default(false)
  isProfileComplete Boolean @default(false)

  refreshTokens RefreshToken[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accommodations Accommodation[]

  isPaymentAccepted Boolean @default(false)

  @@map("users")
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  otp       String
  type      OtpType
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, type])
  @@map("otps")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  expiresAt DateTime
  isRevoked Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// Create accommodation
enum AccommodationType {
  APARTMENT
  HOUSE
  STUDIO
  VILLA
  OTHER
}

model Accommodation {
  id     String @id @default(uuid())
  hostId String
  host   User   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  name              String
  accommodationType AccommodationType
  address           String
  city              String
  zipCode           String
  floor             String?
  doorCode          String?
  numberOfRooms     Int
  surface           Float?
  hasElevator       Boolean           @default(false)
  cleaningRate      Float

  checkOutDateTime    DateTime?
  nextCheckinDateTime DateTime?

  notes        String?
  keys         String?
  accessCode   String?
  instructions String?
  frequency    String?

  photos      String[]     @default([])
  assignments Assignment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("accommodations")
}

// assignment model 

enum AssignmentRole {
  PRIMARY
  SUBSTITUTE
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REFUSED
  COMPLETED
}

model Assignment {
  id String @id @default(uuid())

  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  cleanerId String
  cleaner   User   @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  role             AssignmentRole   @default(SUBSTITUTE)
  pricePerCleaning Float
  message          String?
  status           AssignmentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A cleaner can only have ONE assignment record per accommodation -
  // prevents accidentally sending the same invite twice.
  @@unique([accommodationId, cleanerId])
  @@map("assignments")
}
