generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HOST
  CLEANER
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  password     String?
  firstName    String?
  lastName     String?
  phone        String?
  profileImage String?
  role         Role?

  // Shared profile fields (Host + Cleaner both can use)
  about    String?
  playerId String? // OneSignal push notification id

  // Cleaner-only onboarding fields
  siretNumber            String?
  isProfessionalVerified Boolean      @default(false)
  workCity               String?
  workLatitude           Float?
  workLongitude          Float?
  serviceRadius          Int?
  availability           String? // full_time | part_time | flexible
  licenseNumber          String?
  biography              String?
  interventionZone       String?
  languages              String[]     @default([])
  servicesOffered        String[]     @default([])
  assignments            Assignment[]

  hostSchedules    Schedule[] @relation("HostSchedules") // <-- add this
  cleanerSchedules Schedule[] @relation("CleanerSchedules")

  // becomes true once the cleaner completes the mandatory
  // post-signup "setup profile" wizard (cannot be skipped)
  isCleanerProfileSetupComplete Boolean @default(false)

  isEmailVerified   Boolean @default(false)
  isProfileComplete Boolean @default(false)

  refreshTokens RefreshToken[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accommodations Accommodation[]

  isPaymentAccepted Boolean    @default(false)
  schedules         Schedule[]

  @@map("users")
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  otp       String
  type      OtpType
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, type])
  @@map("otps")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  expiresAt DateTime
  isRevoked Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// Create accommodation
enum AccommodationType {
  APARTMENT
  HOUSE
  STUDIO
  VILLA
  OTHER
}

model Accommodation {
  id     String @id @default(uuid())
  hostId String
  host   User   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  name              String
  accommodationType AccommodationType
  address           String
  city              String
  zipCode           String
  floor             String?
  doorCode          String?
  numberOfRooms     Int
  surface           Float?
  hasElevator       Boolean           @default(false)
  cleaningRate      Float

  checkOutDateTime    DateTime?
  nextCheckinDateTime DateTime?

  notes        String?
  keys         String?
  accessCode   String?
  instructions String?
  frequency    String?

  photos      String[]     @default([])
  assignments Assignment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  schedules Schedule[]

  @@map("accommodations")
}

// assignment model 

enum AssignmentRole {
  PRIMARY
  SUBSTITUTE
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REFUSED
  COMPLETED
}

model Assignment {
  id String @id @default(uuid())

  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  cleanerId String
  cleaner   User   @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  role             AssignmentRole   @default(SUBSTITUTE)
  pricePerCleaning Float
  message          String?
  status           AssignmentStatus @default(PENDING)

  schedules Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A cleaner can only have ONE assignment record per accommodation -
  // prevents accidentally sending the same invite twice.
  @@unique([accommodationId, cleanerId])
  @@map("assignments")
}

// schedule create
enum ScheduleStatus {
  PENDING // host created it, waiting for the cleaner to respond
  ACCEPTED // cleaner accepted, cleaning is confirmed to happen
  REFUSED // cleaner refused
  PROOF_SUBMITTED // cleaner finished cleaning and submitted proof photos
  COMPLETED // host reviewed the proof and approved it
  INVALIDATED // host reviewed the proof and rejected it
  DISPUTED // cleaner disputes the host's invalidation
}

model Schedule {
  id String @id @default(uuid())

  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  // Links back to the Assignment so we always know which cleaner<->host
  // relationship this cleaning belongs to (role, agreed price, etc.)
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  hostId String
  host   User   @relation("HostSchedules", fields: [hostId], references: [id], onDelete: Cascade)

  cleanerId String
  cleaner   User   @relation("CleanerSchedules", fields: [cleanerId], references: [id], onDelete: Cascade)

  date         DateTime
  checkOutTime String // "HH:mm" - guest check-out, cleaning window starts here
  checkInTime  String // "HH:mm" - next guest check-in, cleaning must finish before this
  notes        String? // instructions from the host to the cleaner

  status ScheduleStatus @default(PENDING)

  proofPhotos String[] @default([])
  proofNotes  String?

  invalidReason String?
  disputeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@map("schedules")
}
